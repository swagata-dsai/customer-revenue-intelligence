// =============================================================================
// Customer Revenue Intelligence - DAX measure library (STEP 11)
// SYNTHETIC DATA. Generated by src/powerbi_dax.py; do not edit by hand.
//
// How to use: in Power BI Desktop create a blank table called _Measures
// (Home > Enter data, one dummy column, load, then delete the column), and add
// each measure below to it. Set the Display folder and Format string shown in
// the comment above each measure.
//
// Conventions
//   * Revenue rule: only Delivered lines count. Every currency measure filters
//     FactSales[Is_Delivered] = 1, exactly as vw_delivered_sales does in SQL.
//   * Customer-state measures (recency, frequency, CLV, segment) are a SNAPSHOT
//     at the reference date 2026-01-01 taken in Steps 5-7. They sit on
//     DimCustomer and deliberately do NOT change with the Date slicer.
//   * "Inactive", never "churned" - no churn event is defined in this project.
//   * Historical / Predicted / Forecast are kept in separate measures and are
//     never added together.
// =============================================================================


// ==========================================================================
// 01 Revenue
// ==========================================================================

// Delivered revenue. The single revenue definition used by every page.
// Display folder: 01 Revenue | Format: "₹"#,0;-"₹"#,0
Total Revenue = CALCULATE ( SUM ( FactSales[Sales] ), FactSales[Is_Delivered] = 1 )

// Cost of the delivered lines.
// Display folder: 01 Revenue | Format: #,0
Total Cost = CALCULATE ( SUM ( FactSales[Cost] ), FactSales[Is_Delivered] = 1 )

// Value of ALL order lines including Returned and Cancelled - the gross figure revenue is measured against.
// Display folder: 01 Revenue | Format: #,0
Booked Value = SUM ( FactSales[Booked_Value] )

// Booked value lost to returns and cancellations.
// Display folder: 01 Revenue | Format: #,0
Revenue Not Realised = [Booked Value] - [Total Revenue]

// Share of booked value that never became revenue.
// Display folder: 01 Revenue | Format: 0.0%
Revenue Not Realised % = DIVIDE ( [Revenue Not Realised], [Booked Value] )

// Revenue in the same period one year earlier.
// Display folder: 01 Revenue | Format: #,0
Revenue PY = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( DimDate[Date] ) )

// Year-over-year revenue change in rupees.
// Display folder: 01 Revenue | Format: #,0
Revenue Growth = IF ( NOT ISBLANK ( [Revenue PY] ), [Total Revenue] - [Revenue PY] )

// Year-over-year revenue growth.
// Display folder: 01 Revenue | Format: +0.0%;-0.0%;0.0%
Revenue Growth % = DIVIDE ( [Revenue Growth], [Revenue PY] )

// Revenue in the previous month.
// Display folder: 01 Revenue | Format: #,0
Revenue PM = CALCULATE ( [Total Revenue], DATEADD ( DimDate[Date], -1, MONTH ) )

// Month-over-month revenue growth.
// Display folder: 01 Revenue | Format: +0.0%;-0.0%;0.0%
Revenue MoM % = DIVIDE ( [Total Revenue] - [Revenue PM], [Revenue PM] )

// Calendar year-to-date revenue.
// Display folder: 01 Revenue | Format: #,0
Revenue YTD = TOTALYTD ( [Total Revenue], DimDate[Date] )

// Mean revenue per month, counting only months that have delivered revenue.
// Display folder: 01 Revenue | Format: #,0
Avg Monthly Revenue = AVERAGEX (
    FILTER ( VALUES ( DimDate[Year_Month] ), NOT ISBLANK ( [Total Revenue] ) ),
    [Total Revenue]
)

// Revenue rescaled for chart axes, so axis labels stay short and readable.
// Display folder: 01 Revenue | Format: #,0.0
Revenue (₹ lakh) = DIVIDE ( [Total Revenue], 100000 )

// Card label in Indian units (crore / lakh) - used on the KPI cards.
// Display folder: 01 Revenue | Format: Text
Revenue Label = VAR v = [Total Revenue]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( v ), "-",
        ABS ( v ) >= 10000000, FORMAT ( DIVIDE ( v, 10000000 ), "₹0.00" ) & " Cr",
        ABS ( v ) >= 100000, FORMAT ( DIVIDE ( v, 100000 ), "₹0.00" ) & " L",
        FORMAT ( v, "₹#,0" )
    )

// ==========================================================================
// 02 Profitability
// ==========================================================================

// Profit on delivered lines.
// Display folder: 02 Profitability | Format: #,0
Total Profit = CALCULATE ( SUM ( FactSales[Profit] ), FactSales[Is_Delivered] = 1 )

// Profit as a share of revenue.
// Display folder: 02 Profitability | Format: 0.0%
Profit Margin % = DIVIDE ( [Total Profit], [Total Revenue] )

// Mean profit per delivered order.
// Display folder: 02 Profitability | Format: #,0
Avg Profit per Order = DIVIDE ( [Total Profit], [Total Orders] )

// Profit in the same period one year earlier.
// Display folder: 02 Profitability | Format: #,0
Profit PY = CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( DimDate[Date] ) )

// Year-over-year profit growth.
// Display folder: 02 Profitability | Format: +0.0%;-0.0%;0.0%
Profit Growth % = DIVIDE ( [Total Profit] - [Profit PY], [Profit PY] )

// Change in profit margin versus last year, in percentage points.
// Display folder: 02 Profitability | Format: +0.0;-0.0;0.0
Margin Change PY (pp) = ( [Profit Margin %] - DIVIDE ( [Profit PY], [Revenue PY] ) ) * 100

// Profit card label in crore / lakh.
// Display folder: 02 Profitability | Format: Text
Profit Label = VAR v = [Total Profit]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( v ), "-",
        ABS ( v ) >= 10000000, FORMAT ( DIVIDE ( v, 10000000 ), "₹0.00" ) & " Cr",
        ABS ( v ) >= 100000, FORMAT ( DIVIDE ( v, 100000 ), "₹0.00" ) & " L",
        FORMAT ( v, "₹#,0" )
    )

// ==========================================================================
// 03 Orders
// ==========================================================================

// Orders with at least one delivered line - the Step 3 order definition.
// Display folder: 03 Orders | Format: #,0
Total Orders = CALCULATE ( DISTINCTCOUNT ( FactSales[Order_ID] ), FactSales[Is_Delivered] = 1 )

// Delivered order lines (the fact grain).
// Display folder: 03 Orders | Format: #,0
Order Lines = CALCULATE ( COUNTROWS ( FactSales ), FactSales[Is_Delivered] = 1 )

// Units sold on delivered lines.
// Display folder: 03 Orders | Format: #,0
Total Quantity = CALCULATE ( SUM ( FactSales[Quantity] ), FactSales[Is_Delivered] = 1 )

// AOV = delivered revenue / delivered orders.
// Display folder: 03 Orders | Format: #,0
Average Order Value = DIVIDE ( [Total Revenue], [Total Orders] )

// Mean units per delivered order.
// Display folder: 03 Orders | Format: 0.00
Avg Quantity per Order = DIVIDE ( [Total Quantity], [Total Orders] )

// Value-weighted average discount: discount given / list value. Not the mean of the discount column, which would weight a ₹500 line like a ₹50,000 one.
// Display folder: 03 Orders | Format: 0.0%
Avg Discount % = CALCULATE (
    DIVIDE (
        SUMX ( FactSales, FactSales[Quantity] * FactSales[Unit_Price] * FactSales[Discount] ),
        SUMX ( FactSales, FactSales[Quantity] * FactSales[Unit_Price] )
    ),
    FactSales[Is_Delivered] = 1
)

// ==========================================================================
// 04 Customers
// ==========================================================================

// Customers on file, whether or not they ever received an order.
// Display folder: 04 Customers | Format: #,0
Registered Customers = COUNTROWS ( DimCustomer )

// Distinct customers with a delivered order in the current filter context.
// Display folder: 04 Customers | Format: #,0
Total Customers = CALCULATE ( DISTINCTCOUNT ( FactSales[Customer_ID] ), FactSales[Is_Delivered] = 1 )

// Customers whose last delivered purchase was under 180 days before the reference date 2026-01-01 (the Step 7 inactivity threshold). A snapshot: it does not move with the Date slicer. Inactivity, not churn.
// Display folder: 04 Customers | Format: #,0
Active Customers = CALCULATE (
    COUNTROWS ( DimCustomer ),
    KEEPFILTERS ( DimCustomer[Recency_Days] < 180 ),
    DimCustomer[Has_Delivered_Order] = 1
)

// Snapshot count of customers inactive for 180 days or more.
// Display folder: 04 Customers | Format: #,0
Inactive Customers (180+ days) = CALCULATE (
    COUNTROWS ( DimCustomer ),
    KEEPFILTERS ( DimCustomer[Recency_Days] >= 180 )
)

// Customers whose FIRST delivered purchase falls inside the selected dates. For 2023 this counts first purchases observed in the data, which includes customers acquired earlier (see DimCustomer[Acquisition_Status]).
// Display folder: 04 Customers | Format: #,0
New Customers = VAR StartDate = MIN ( DimDate[Date] )
VAR EndDate = MAX ( DimDate[Date] )
RETURN
    CALCULATE (
        COUNTROWS ( DimCustomer ),
        KEEPFILTERS (
            DimCustomer[First_Purchase_Date] >= StartDate
                && DimCustomer[First_Purchase_Date] <= EndDate
        )
    )

// Snapshot count of customers with 2 or more delivered orders in total.
// Display folder: 04 Customers | Format: #,0
Repeat Customers = CALCULATE ( COUNTROWS ( DimCustomer ), KEEPFILTERS ( DimCustomer[Frequency_Orders] >= 2 ) )

// Customers with 2 or more delivered orders WITHIN the selected dates - the period version of the measure above.
// Display folder: 04 Customers | Format: #,0
Repeat Customers (in period) = COUNTROWS (
    FILTER ( VALUES ( DimCustomer[Customer_ID] ), [Total Orders] >= 2 )
)

// Share of purchasing customers who ordered more than once.
// Display folder: 04 Customers | Format: 0.0%
Repeat Customer % = DIVIDE ( [Repeat Customers], [Total Customers] )

// Purchase frequency in the current context.
// Display folder: 04 Customers | Format: 0.00
Avg Orders per Customer = DIVIDE ( [Total Orders], [Total Customers] )

// ==========================================================================
// 05 Customer value
// ==========================================================================

// Revenue per purchasing customer in the current context.
// Display folder: 05 Customer value | Format: #,0
Avg Customer Revenue = DIVIDE ( [Total Revenue], [Total Customers] )

// A customer's (or customer selection's) share of revenue, against all customers with the other slicers still applied.
// Display folder: 05 Customer value | Format: 0.0%
Customer Revenue Contribution % = DIVIDE (
    [Total Revenue],
    CALCULATE ( [Total Revenue], REMOVEFILTERS ( DimCustomer ) )
)

// An RFM segment's share of revenue.
// Display folder: 05 Customer value | Format: 0.0%
Segment Revenue Contribution % = DIVIDE (
    [Total Revenue],
    CALCULATE ( [Total Revenue], REMOVEFILTERS ( DimRFMSegment, DimCustomer ) )
)

// A K-Means cluster's share of revenue.
// Display folder: 05 Customer value | Format: 0.0%
Cluster Revenue Contribution % = DIVIDE (
    [Total Revenue],
    CALCULATE ( [Total Revenue], REMOVEFILTERS ( DimCluster, DimCustomer ) )
)

// A category's or product's share of revenue.
// Display folder: 05 Customer value | Format: 0.0%
Category Revenue Contribution % = DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], REMOVEFILTERS ( DimProduct ) ) )

// A region's share of revenue.
// Display folder: 05 Customer value | Format: 0.0%
Region Revenue Contribution % = DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], REMOVEFILTERS ( DimGeography ) ) )

// Step 7 historical customer value: profit actually earned to date. NOT a prediction.
// Display folder: 05 Customer value | Format: #,0
Historical Profit CLV = SUM ( DimCustomer[Historical_Profit_CLV] )

// Step 7 historical revenue per customer, summed over the selection.
// Display folder: 05 Customer value | Format: #,0
Historical Revenue CLV = SUM ( DimCustomer[Historical_Revenue_CLV] )

// Step 7 model ESTIMATE of the next 12 months' profit. Always labelled as an estimate and never added to historical value.
// Display folder: 05 Customer value | Format: #,0
Estimated 12M Future Profit = SUM ( DimCustomer[Estimated_12M_Future_Profit] )

// Mean estimated 12-month future profit per customer in the selection.
// Display folder: 05 Customer value | Format: #,0
Avg Estimated 12M Future Profit = AVERAGE ( DimCustomer[Estimated_12M_Future_Profit] )

// Step 7 illustrative 3-year value (12-month estimate x (1 + r + r²), r = 0.839). Illustrative only - it assumes the observed repeat rate persists.
// Display folder: 05 Customer value | Format: #,0
Illustrative 3Y Value = SUM ( DimCustomer[Illustrative_3Y_Value] )

// High historical value AND no delivered purchase for 180+ days (Step 7 flag). 'Potentially at risk', not churned.
// Display folder: 05 Customer value | Format: #,0
At-Risk High-Value Customers = CALCULATE (
    COUNTROWS ( DimCustomer ),
    KEEPFILTERS ( DimCustomer[Potentially_At_Risk_High_Value] = 1 )
)

// Top 20% of customers by historical profit (Step 7 flag).
// Display folder: 05 Customer value | Format: #,0
High-Value Customers = CALCULATE ( COUNTROWS ( DimCustomer ), KEEPFILTERS ( DimCustomer[High_Historical_Value] = 1 ) )

// ==========================================================================
// 06 Segmentation (RFM & clusters)
// ==========================================================================

// Customers in the selected segment or cluster (snapshot assignment).
// Display folder: 06 Segmentation (RFM & clusters) | Format: #,0
Segment Customers = CALCULATE ( COUNTROWS ( DimCustomer ), KEEPFILTERS ( DimCustomer[Has_Delivered_Order] = 1 ) )

// Share of the customer base in this segment or cluster.
// Display folder: 06 Segmentation (RFM & clusters) | Format: 0.0%
Segment Customer % = DIVIDE (
    [Segment Customers],
    CALCULATE ( [Segment Customers], REMOVEFILTERS ( DimRFMSegment, DimCluster, DimCustomer ) )
)

// Mean days since the last delivered purchase, at the 2026-01-01 reference date.
// Display folder: 06 Segmentation (RFM & clusters) | Format: #,0
Avg Recency (days) = AVERAGE ( DimCustomer[Recency_Days] )

// Mean lifetime delivered orders per customer.
// Display folder: 06 Segmentation (RFM & clusters) | Format: 0.0
Avg Frequency (orders) = AVERAGE ( DimCustomer[Frequency_Orders] )

// Mean lifetime delivered revenue per customer.
// Display folder: 06 Segmentation (RFM & clusters) | Format: #,0
Avg Monetary (₹) = AVERAGE ( DimCustomer[Monetary_Revenue] )

// Mean R+F+M score (3-15) of the selected customers.
// Display folder: 06 Segmentation (RFM & clusters) | Format: 0.0
Avg RFM Score = AVERAGE ( DimCustomer[RFM_Score] )

// Revenue per customer within the segment or cluster.
// Display folder: 06 Segmentation (RFM & clusters) | Format: #,0
Segment Revenue per Customer = DIVIDE ( [Total Revenue], [Segment Customers] )

// ==========================================================================
// 07 Products & regions
// ==========================================================================

// Share of order lines that were Returned or Cancelled.
// Display folder: 07 Products & regions | Format: 0.0%
Return / Cancel Rate % = DIVIDE (
    CALCULATE ( COUNTROWS ( FactSales ), FactSales[Is_Delivered] = 0 ),
    COUNTROWS ( FactSales )
)

// Distinct products with delivered sales in the current context.
// Display folder: 07 Products & regions | Format: #,0
Products Sold = CALCULATE ( DISTINCTCOUNT ( FactSales[Product_ID] ), FactSales[Is_Delivered] = 1 )

// Product rank by revenue, respecting the slicers - used for Top N / Bottom N.
// Display folder: 07 Products & regions | Format: #,0
Revenue Rank (product) = IF (
    NOT ISBLANK ( [Total Revenue] ),
    RANKX ( ALLSELECTED ( DimProduct[Product_Name] ), [Total Revenue], , DESC, DENSE )
)

// How far a product's margin sits above or below its own category's margin, in points. This is the metric the Bottom-products visual ranks on.
// Display folder: 07 Products & regions | Format: +0.0;-0.0;0.0
Margin vs Category (pp) = VAR CategoryMargin =
    CALCULATE ( [Profit Margin %], REMOVEFILTERS ( DimProduct[Product_Name], DimProduct[Sub_Category] ) )
RETURN
    ( [Profit Margin %] - CategoryMargin ) * 100

// ==========================================================================
// 08 Prediction (Step 8 ML)
// ==========================================================================

// Step 8 model prediction of customer revenue for the target quarter. Test split only.
// Display folder: 08 Prediction (Step 8 ML) | Format: #,0
Predicted Revenue (ML) = SUM ( FactRevenuePrediction[Predicted_Revenue] )

// The matching actual revenue for those same customer-quarters, so predicted and actual are always compared on identical rows.
// Display folder: 08 Prediction (Step 8 ML) | Format: #,0
Actual Revenue (prediction test) = SUM ( FactRevenuePrediction[Actual_Revenue] )

// The previous-quarter baseline the model is judged against.
// Display folder: 08 Prediction (Step 8 ML) | Format: #,0
Naive Baseline (prediction) = SUM ( FactRevenuePrediction[Naive_Baseline] )

// Mean absolute error per customer-quarter.
// Display folder: 08 Prediction (Step 8 ML) | Format: #,0
Prediction MAE = AVERAGE ( FactRevenuePrediction[Absolute_Error] )

// Root mean squared error per customer-quarter.
// Display folder: 08 Prediction (Step 8 ML) | Format: #,0
Prediction RMSE = SQRT ( AVERAGEX ( FactRevenuePrediction, FactRevenuePrediction[Prediction_Error] ^ 2 ) )

// R² over the rows in context. On the full test split this reproduces the Step 8 figure; inside a slicer it is the R² of that subset, which is a different quantity.
// Display folder: 08 Prediction (Step 8 ML) | Format: 0.000
Prediction R2 = VAR MeanActual = AVERAGE ( FactRevenuePrediction[Actual_Revenue] )
VAR SSres =
    SUMX ( FactRevenuePrediction, FactRevenuePrediction[Prediction_Error] ^ 2 )
VAR SStot =
    SUMX (
        FactRevenuePrediction,
        ( FactRevenuePrediction[Actual_Revenue] - MeanActual ) ^ 2
    )
RETURN
    1 - DIVIDE ( SSres, SStot )

// Total over- or under-prediction. MAPE is deliberately absent: many customer-quarters have an actual of 0, so a percentage error is undefined for them.
// Display folder: 08 Prediction (Step 8 ML) | Format: +0.0%;-0.0%;0.0%
Prediction Bias % = DIVIDE (
    [Predicted Revenue (ML)] - [Actual Revenue (prediction test)],
    [Actual Revenue (prediction test)]
)

// The reported Step 8 / Step 9 metric from the ModelMetrics table; used by the model performance matrix so no metric is ever retyped into a text box.
// Display folder: 08 Prediction (Step 8 ML) | Format: #,0.000
Metric Value = SUM ( ModelMetrics[Value] )

// ==========================================================================
// 09 Forecast (Step 9 time series)
// ==========================================================================

// Actual monthly revenue, 2023-01 to 2025-12. Equals [Total Revenue] by month.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Historical Revenue (monthly) = CALCULATE (
    SUM ( FactForecast[Actual_Revenue] ),
    FactForecast[Record_Type] = "Historical actual"
)

// Future forecast, 2026-01 to 2026-06, from the model fitted on all 36 months.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Revenue = CALCULATE ( SUM ( FactForecast[Forecast_Revenue] ), FactForecast[Series_Label] = "Forecast" )

// Validation and test forecasts produced without seeing those months - the evidence for the accuracy figures.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Backtest Forecast = CALCULATE (
    SUM ( FactForecast[Forecast_Revenue] ),
    FactForecast[Series_Label] = "Forecast (backtest)"
)

// Lower bound of the 80% prediction interval.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Lower 80 = CALCULATE ( SUM ( FactForecast[Lower_80] ), FactForecast[Series_Label] = "Forecast" )

// Upper bound of the 80% prediction interval.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Upper 80 = CALCULATE ( SUM ( FactForecast[Upper_80] ), FactForecast[Series_Label] = "Forecast" )

// Lower bound of the 95% prediction interval.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Lower 95 = CALCULATE ( SUM ( FactForecast[Lower_95] ), FactForecast[Series_Label] = "Forecast" )

// Upper bound of the 95% prediction interval.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Upper 95 = CALCULATE ( SUM ( FactForecast[Upper_95] ), FactForecast[Series_Label] = "Forecast" )

// Width of the 95% interval - it widens with the horizon, which is the honest way to show that a 6-month-out month is less certain than next month.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Interval Width 95 = [Forecast Upper 95] - [Forecast Lower 95]

// Number of forecast months shown (6).
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Horizon (months) = CALCULATE ( DISTINCTCOUNT ( FactForecast[Year_Month] ), FactForecast[Series_Label] = "Forecast" )

// Total forecast revenue for the whole 6-month horizon, independent of the Date slicer.
// Display folder: 09 Forecast (Step 9 time series) | Format: #,0
Forecast Total (next 6 months) = CALCULATE (
    SUM ( FactForecast[Forecast_Revenue] ),
    REMOVEFILTERS ( DimDate ),
    FactForecast[Series_Label] = "Forecast"
)

// Forecast-total card label in crore / lakh.
// Display folder: 09 Forecast (Step 9 time series) | Format: Text
Forecast Label = VAR v = [Forecast Total (next 6 months)]
RETURN
    IF (
        ISBLANK ( v ),
        "-",
        IF (
            ABS ( v ) >= 10000000,
            FORMAT ( DIVIDE ( v, 10000000 ), "₹0.00" ) & " Cr",
            FORMAT ( DIVIDE ( v, 100000 ), "₹0.00" ) & " L"
        )
    )

// ==========================================================================
// 10 Labels & context
// ==========================================================================

// Shows the selected date range on every page so a filtered number is never mistaken for the full-period number.
// Display folder: 10 Labels & context | Format: Text
Date Range Label = VAR d1 = MIN ( DimDate[Date] )
VAR d2 = MAX ( DimDate[Date] )
RETURN FORMAT ( d1, "dd MMM yyyy" ) & " - " & FORMAT ( d2, "dd MMM yyyy" )

// The Step 8 model name, read from ModelInfo rather than typed onto the page.
// Display folder: 10 Labels & context | Format: Text
Selected Prediction Model = CALCULATE (
    SELECTEDVALUE ( ModelInfo[Value] ),
    ModelInfo[Model_Area] = "Revenue prediction (ML)",
    ModelInfo[Attribute] = "Selected model",
    REMOVEFILTERS ()
)

// The Step 9 model name, read from ModelInfo.
// Display folder: 10 Labels & context | Format: Text
Selected Forecast Model = CALCULATE (
    SELECTEDVALUE ( ModelInfo[Value] ),
    ModelInfo[Model_Area] = "Revenue forecast (time series)",
    ModelInfo[Attribute] = "Selected model",
    REMOVEFILTERS ()
)

// Footer text shown on HOME and the Executive Overview.
// Display folder: 10 Labels & context | Format: Text
Data Disclaimer = "Synthetic dataset - generated for an internship project. Not real customer data."

// Warns the reader when a page is showing a filtered subset.
// Display folder: 10 Labels & context | Format: Text
Filters Applied = VAR n =
    IF ( ISFILTERED ( DimGeography[Region] ), 1, 0 )
        + IF ( ISFILTERED ( DimProduct[Category] ), 1, 0 )
        + IF ( ISFILTERED ( DimProduct[Sub_Category] ), 1, 0 )
        + IF ( ISFILTERED ( DimRFMSegment[RFM_Segment] ), 1, 0 )
        + IF ( ISFILTERED ( DimCluster[Cluster_Label] ), 1, 0 )
RETURN
    IF ( n = 0, "No dimension filters applied", n & " dimension filter(s) applied" )
