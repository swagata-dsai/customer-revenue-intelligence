{
  "name": "Customer Revenue Intelligence - Dark",
  "dataColors": [
    "#3987E5",
    "#D95926",
    "#199E70",
    "#C98500",
    "#D55181",
    "#008300",
    "#9085E9",
    "#E66767"
  ],
  "background": "#0B111C",
  "foreground": "#E6EDF7",
  "foregroundNeutralSecondary": "#8E9BB3",
  "tableAccent": "#3987E5",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#3987E5",
  "center": "#8E9BB3",
  "minimum": "#141C2B",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#FFFFFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#E6EDF7"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#E6EDF7"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 34,
      "color": "#FFFFFF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#141C2B"
              }
            },
            "transparency": 8
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#25324A"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#141C2B"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "fontSize": 10
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8E9BB3"
              }
            },
            "fontSize": 10,
            "gridlineShow": false,
            "lineColor": {
              "solid": {
                "color": "#223047"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8E9BB3"
              }
            },
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#223047"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "dotted"
          }
        ],
        "wordWrap": [
          {
            "show": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#8E9BB3"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "fillPoint": [
          {
            "show": true
          }
        ],
        "bubbles": [
          {
            "bubbleSize": -10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#141C2B"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "background": {
              "solid": {
                "color": "#141C2B"
              }
            },
            "fontSize": 10
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#8E9BB3"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVerticalColor": {
              "solid": {
                "color": "#223047"
              }
            },
            "gridHorizontalColor": {
              "solid": {
                "color": "#223047"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8E9BB3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B111C"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141C2B"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#141C2B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}